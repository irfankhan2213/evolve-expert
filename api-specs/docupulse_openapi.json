{
  "openapi": "3.0.3",
  "info": {
    "title": "DocuPulse AI - Invoice & Document Intelligence API",
    "description": "Turnkey Multimodal AI Document Intelligence & Financial OCR API for developer marketplaces. Instantly extracts structured JSON from invoices, receipts, tax documents, and purchase orders. Features automatic Indian GSTIN & VAT verification, tax split computation, line-item table parsing, and payment metadata recognition. Optimized for RapidAPI Hub integration.",
    "version": "1.0.0",
    "termsOfService": "https://docupulse.vercel.app/terms",
    "contact": {
      "name": "DocuPulse AI Developer Relations",
      "url": "https://docupulse.vercel.app",
      "email": "api-support@docupulse.ai"
    },
    "license": {
      "name": "Commercial API License",
      "url": "https://docupulse.vercel.app/license"
    }
  },
  "servers": [
    {
      "url": "https://docupulse-ai.p.rapidapi.com",
      "description": "RapidAPI Hub Production Gateway (Metered & Authenticated)"
    },
    {
      "url": "https://docupulse.vercel.app",
      "description": "Direct Production Server"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local Development Sandbox"
    }
  ],
  "security": [
    {
      "RapidAPIKey": [],
      "RapidAPIHost": []
    }
  ],
  "tags": [
    {
      "name": "Document Intelligence",
      "description": "AI-powered multimodal OCR and structured financial extraction"
    },
    {
      "name": "System & Health",
      "description": "Service status and connectivity preflight verification"
    }
  ],
  "paths": {
    "/api/v1/extract": {
      "post": {
        "tags": [
          "Document Intelligence"
        ],
        "summary": "Extract Structured Financial Data from Document",
        "description": "Processes document images (PNG, JPEG, WEBP), PDFs, or raw OCR text into fully parsed, schema-validated JSON. Detects document classification, vendor credentials (including GSTIN, PAN, tax IDs), customer details, line items with quantity and tax rate, subtotal/tax/discount financial breakdowns, and payment details.",
        "operationId": "extractDocumentData",
        "parameters": [
          {
            "name": "X-RapidAPI-Key",
            "in": "header",
            "required": true,
            "description": "Your RapidAPI subscription key required for metered marketplace access.",
            "schema": {
              "type": "string",
              "example": "9a8b7c6d5e4f3a2b1c0d_example_rapidapi_key"
            }
          },
          {
            "name": "X-RapidAPI-Host",
            "in": "header",
            "required": true,
            "description": "RapidAPI API host domain.",
            "schema": {
              "type": "string",
              "default": "docupulse-ai.p.rapidapi.com",
              "example": "docupulse-ai.p.rapidapi.com"
            }
          },
          {
            "name": "X-RapidAPI-Proxy-Secret",
            "in": "header",
            "required": false,
            "description": "Secret token injected by RapidAPI Proxy Gateway to verify genuine proxy traffic.",
            "schema": {
              "type": "string",
              "example": "d0c0pu1s3_pr0xy_s3cr3t_t0k3n"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Document payload passed either as a JSON object (base64 or text) or as a multipart form data upload.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtractJsonRequest"
              },
              "examples": {
                "base64_invoice": {
                  "summary": "Base64 Image Extraction",
                  "description": "Sending an invoice image encoded as base64 string with optional document type hint.",
                  "value": {
                    "image": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==",
                    "mimeType": "image/png",
                    "documentTypeHint": "invoice"
                  }
                },
                "raw_text_receipt": {
                  "summary": "Raw OCR Text Extraction",
                  "description": "Sending unparsed raw OCR text extracted from a scanner or POS terminal.",
                  "value": {
                    "text": "TAX INVOICE\nCloudScale Technologies Pvt Ltd\nGSTIN: 29ABCDE1234F1Z5\nInvoice No: INV-824102\nDate: 2026-10-11\nCustomer: Nexus Enterprises India Ltd (27AABCN5544K1ZP)\n1. Enterprise Cloud Infrastructure x1 - ₹18,500 (GST 18%)\n2. SLA Management Support x1 - ₹6,500 (GST 18%)\nSubtotal: ₹30,000\nGST 18%: ₹5,400\nTotal: ₹35,400\nBank: HDFC Bank A/C 50200034981120 IFSC: HDFC0001234",
                    "documentTypeHint": "invoice"
                  }
                }
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/ExtractMultipartRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Extraction completed successfully with structured output.",
            "headers": {
              "Access-Control-Allow-Origin": {
                "schema": {
                  "type": "string",
                  "example": "*"
                },
                "description": "CORS authorization header"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractSuccessResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "document_type": "invoice",
                    "invoice_number": "INV-841920",
                    "invoice_date": "2026-10-11",
                    "due_date": "2026-10-26",
                    "vendor": {
                      "name": "CloudScale Technologies Pvt Ltd",
                      "address": "Plot 42, HSR Layout Sector 2, Bengaluru, KA 560102",
                      "tax_id_gstin": "29ABCDE1234F1Z5",
                      "email": "billing@cloudscale.io",
                      "phone": "+91 80 4920 1100",
                      "website": "https://cloudscale.io"
                    },
                    "customer": {
                      "name": "Nexus Enterprises India Ltd",
                      "address": "7th Floor, Express Towers, Nariman Point, Mumbai, MH 400021",
                      "tax_id_gstin": "27AABCN5544K1ZP",
                      "email": "finance@nexusindia.com"
                    },
                    "line_items": [
                      {
                        "description": "Enterprise Cloud Infrastructure Services (Compute & Storage)",
                        "quantity": 1,
                        "unit_price": 18500,
                        "tax_rate": 18,
                        "amount": 18500
                      },
                      {
                        "description": "Dedicated Support & SLA Management (Q4)",
                        "quantity": 1,
                        "unit_price": 6500,
                        "tax_rate": 18,
                        "amount": 6500
                      },
                      {
                        "description": "Automated Backup & Disaster Recovery Vault",
                        "quantity": 2,
                        "unit_price": 2500,
                        "tax_rate": 18,
                        "amount": 5000
                      }
                    ],
                    "financials": {
                      "subtotal": 30000,
                      "tax_amount": 5400,
                      "discount": 0,
                      "total_amount": 35400,
                      "currency": "INR"
                    },
                    "payment_info": {
                      "method": "Bank Transfer / NEFT / UPI",
                      "bank_account": "HDFC0001234 - A/C 50200034981120",
                      "upi_id": "cloudscale@hdfcbank",
                      "payment_terms": "Net 15 Days",
                      "payment_status": "pending"
                    },
                    "confidence_score": 0.992,
                    "processing_time_ms": 482
                  },
                  "meta": {
                    "platform": "RapidAPI",
                    "status": "success",
                    "timestamp": "2026-10-11T12:00:00.000Z"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid payload format, unreadable file bytes, or missing document input.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": "No document content provided in request payload. Pass 'image', 'fileBase64', or 'text'."
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized access. Missing or invalid X-RapidAPI-Key or X-RapidAPI-Proxy-Secret header.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": "Invalid or missing X-RapidAPI-Key header. Please subscribe via RapidAPI Hub."
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large. The uploaded file exceeds the 15MB limit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": "Document size exceeds the 15MB maximum allowable file size."
                }
              }
            }
          },
          "429": {
            "description": "Rate limit or monthly quota exceeded for your subscription tier.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": "Rate limit quota exceeded. Upgrade your tier on RapidAPI Hub."
                }
              }
            }
          },
          "500": {
            "description": "Internal server or AI Vision extraction engine error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": "Internal document extraction error"
                }
              }
            }
          }
        }
      },
      "options": {
        "tags": [
          "System & Health"
        ],
        "summary": "CORS Preflight Check",
        "description": "Handles cross-origin preflight requests from client applications and RapidAPI Test Console.",
        "operationId": "extractOptions",
        "responses": {
          "204": {
            "description": "No content. Preflight accepted.",
            "headers": {
              "Access-Control-Allow-Origin": {
                "schema": {
                  "type": "string",
                  "example": "*"
                }
              },
              "Access-Control-Allow-Methods": {
                "schema": {
                  "type": "string",
                  "example": "GET, POST, OPTIONS"
                }
              },
              "Access-Control-Allow-Headers": {
                "schema": {
                  "type": "string",
                  "example": "Content-Type, Authorization, X-RapidAPI-Key, X-RapidAPI-Host"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "RapidAPIKey": {
        "type": "apiKey",
        "name": "X-RapidAPI-Key",
        "in": "header",
        "description": "Your personal RapidAPI developer key obtained from the RapidAPI Developer Dashboard."
      },
      "RapidAPIHost": {
        "type": "apiKey",
        "name": "X-RapidAPI-Host",
        "in": "header",
        "description": "The target RapidAPI host (e.g., docupulse-ai.p.rapidapi.com)."
      },
      "RapidAPIProxySecret": {
        "type": "apiKey",
        "name": "X-RapidAPI-Proxy-Secret",
        "in": "header",
        "description": "Internal gateway secret header verified by DocuPulse AI backend."
      }
    },
    "schemas": {
      "ExtractJsonRequest": {
        "type": "object",
        "description": "JSON payload containing base64 document or raw text for extraction.",
        "properties": {
          "image": {
            "type": "string",
            "description": "Base64 encoded representation of the invoice or receipt image (with or without data URL prefix)."
          },
          "fileBase64": {
            "type": "string",
            "description": "Alternative key for base64 encoded document bytes."
          },
          "document": {
            "type": "string",
            "description": "Alternative key for document string/base64."
          },
          "mimeType": {
            "type": "string",
            "default": "image/png",
            "description": "MIME type of the encoded document.",
            "enum": [
              "image/png",
              "image/jpeg",
              "image/jpg",
              "image/webp",
              "application/pdf"
            ]
          },
          "text": {
            "type": "string",
            "description": "Raw unformatted OCR text from which financial and line-item details should be extracted."
          },
          "documentTypeHint": {
            "type": "string",
            "description": "Optional classification hint to assist the AI model in schema prioritization.",
            "enum": [
              "invoice",
              "receipt",
              "bill",
              "purchase_order",
              "unknown"
            ],
            "default": "invoice"
          }
        }
      },
      "ExtractMultipartRequest": {
        "type": "object",
        "required": [
          "file"
        ],
        "description": "Multipart form payload containing binary document upload.",
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "description": "Binary document file (JPEG, PNG, WEBP, or PDF, max 15MB)."
          },
          "documentTypeHint": {
            "type": "string",
            "description": "Optional classification hint to guide extraction.",
            "enum": [
              "invoice",
              "receipt",
              "bill",
              "purchase_order",
              "unknown"
            ],
            "default": "invoice"
          }
        }
      },
      "VendorInfo": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Vendor or seller legal business name.",
            "example": "CloudScale Technologies Pvt Ltd"
          },
          "address": {
            "type": "string",
            "description": "Vendor registered physical address.",
            "example": "Plot 42, HSR Layout Sector 2, Bengaluru, KA 560102"
          },
          "tax_id_gstin": {
            "type": "string",
            "description": "Vendor Tax ID / GSTIN / VAT number. Automatically verified for 15-character Indian GST format.",
            "example": "29ABCDE1234F1Z5"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Vendor billing contact email.",
            "example": "billing@cloudscale.io"
          },
          "phone": {
            "type": "string",
            "description": "Vendor billing contact phone.",
            "example": "+91 80 4920 1100"
          },
          "website": {
            "type": "string",
            "format": "uri",
            "description": "Vendor corporate website.",
            "example": "https://cloudscale.io"
          }
        }
      },
      "CustomerInfo": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Billed customer or client organization name.",
            "example": "Nexus Enterprises India Ltd"
          },
          "address": {
            "type": "string",
            "description": "Customer billing or delivery address.",
            "example": "7th Floor, Express Towers, Nariman Point, Mumbai, MH 400021"
          },
          "tax_id_gstin": {
            "type": "string",
            "description": "Customer GSTIN or tax identification number.",
            "example": "27AABCN5544K1ZP"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Customer contact email address.",
            "example": "finance@nexusindia.com"
          }
        }
      },
      "InvoiceLineItem": {
        "type": "object",
        "required": [
          "description",
          "quantity",
          "unit_price",
          "amount"
        ],
        "properties": {
          "description": {
            "type": "string",
            "description": "Item description or service title.",
            "example": "Enterprise Cloud Infrastructure Services (Compute & Storage)"
          },
          "quantity": {
            "type": "number",
            "description": "Quantity purchased.",
            "example": 1
          },
          "unit_price": {
            "type": "number",
            "description": "Price per unit before tax.",
            "example": 18500
          },
          "tax_rate": {
            "type": "number",
            "description": "Applied tax rate percentage (e.g. 5, 12, 18, 28).",
            "example": 18
          },
          "amount": {
            "type": "number",
            "description": "Total amount for this line item.",
            "example": 18500
          }
        }
      },
      "Financials": {
        "type": "object",
        "required": [
          "subtotal",
          "tax_amount",
          "total_amount",
          "currency"
        ],
        "properties": {
          "subtotal": {
            "type": "number",
            "description": "Tax-exclusive subtotal amount.",
            "example": 30000
          },
          "tax_amount": {
            "type": "number",
            "description": "Total cumulative taxes assessed (CGST + SGST or IGST or VAT).",
            "example": 5400
          },
          "discount": {
            "type": "number",
            "description": "Total discount deduction applied.",
            "example": 0
          },
          "total_amount": {
            "type": "number",
            "description": "Grand total payable invoice amount.",
            "example": 35400
          },
          "currency": {
            "type": "string",
            "description": "Detected ISO-4217 currency code (e.g., INR, USD, EUR, GBP).",
            "example": "INR"
          }
        }
      },
      "PaymentInfo": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "description": "Recommended or detected payment method.",
            "example": "Bank Transfer / NEFT / UPI"
          },
          "bank_account": {
            "type": "string",
            "description": "Detected bank name, account number, or IFSC/IBAN.",
            "example": "HDFC0001234 - A/C 50200034981120"
          },
          "upi_id": {
            "type": "string",
            "description": "Detected UPI ID / VPA for instant Indian settlement.",
            "example": "cloudscale@hdfcbank"
          },
          "payment_terms": {
            "type": "string",
            "description": "Invoice payment terms (e.g., 'Due on Receipt', 'Net 15 Days').",
            "example": "Net 15 Days"
          },
          "payment_status": {
            "type": "string",
            "description": "Settlement status flagged on document.",
            "enum": [
              "paid",
              "unpaid",
              "pending"
            ],
            "example": "pending"
          }
        }
      },
      "ExtractedInvoiceData": {
        "type": "object",
        "required": [
          "document_type",
          "invoice_number",
          "invoice_date",
          "vendor",
          "line_items",
          "financials",
          "confidence_score",
          "processing_time_ms"
        ],
        "properties": {
          "document_type": {
            "type": "string",
            "enum": [
              "invoice",
              "receipt",
              "bill",
              "purchase_order",
              "unknown"
            ],
            "description": "Classified document taxonomy.",
            "example": "invoice"
          },
          "invoice_number": {
            "type": "string",
            "description": "Extracted invoice, receipt, or reference number.",
            "example": "INV-841920"
          },
          "invoice_date": {
            "type": "string",
            "format": "date",
            "description": "Invoice creation/issue date in ISO YYYY-MM-DD format.",
            "example": "2026-10-11"
          },
          "due_date": {
            "type": "string",
            "format": "date",
            "description": "Due date for payment settlement in ISO YYYY-MM-DD format.",
            "example": "2026-10-26"
          },
          "vendor": {
            "$ref": "#/components/schemas/VendorInfo"
          },
          "customer": {
            "$ref": "#/components/schemas/CustomerInfo"
          },
          "line_items": {
            "type": "array",
            "description": "Itemized list of products or services parsed from the document table.",
            "items": {
              "$ref": "#/components/schemas/InvoiceLineItem"
            }
          },
          "financials": {
            "$ref": "#/components/schemas/Financials"
          },
          "payment_info": {
            "$ref": "#/components/schemas/PaymentInfo"
          },
          "confidence_score": {
            "type": "number",
            "format": "float",
            "description": "Overall extraction confidence score between 0.00 and 1.00.",
            "example": 0.992
          },
          "processing_time_ms": {
            "type": "integer",
            "description": "Server-side OCR & LLM processing latency in milliseconds.",
            "example": 482
          }
        }
      },
      "ResponseMetadata": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "description": "Ingestion origin platform.",
            "example": "RapidAPI"
          },
          "status": {
            "type": "string",
            "example": "success"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-11T12:00:00.000Z"
          }
        }
      },
      "ExtractSuccessResponse": {
        "type": "object",
        "required": [
          "success",
          "data",
          "meta"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "$ref": "#/components/schemas/ExtractedInvoiceData"
          },
          "meta": {
            "$ref": "#/components/schemas/ResponseMetadata"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "success",
          "error"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "string",
            "description": "Human-readable error diagnostic message.",
            "example": "Invalid or unreadable document payload"
          }
        }
      }
    }
  }
}
